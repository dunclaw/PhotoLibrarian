<Application
    x:Class="PhotoLibrarian.AccessibilityTests.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Viewer resources mirror PhotoLibrarian/App.xaml in this isolated test host. -->
            <Style x:Key="ToolbarCommandBarStyle" TargetType="CommandBar"
                   BasedOn="{StaticResource DefaultCommandBarStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="DefaultLabelPosition" Value="Right" />
                <Setter Property="IsDynamicOverflowEnabled" Value="True" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style x:Key="ToolbarIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RibbonCommandStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="RibbonIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RibbonCaptionStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RibbonSeparatorStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="8,12" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="TestSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
