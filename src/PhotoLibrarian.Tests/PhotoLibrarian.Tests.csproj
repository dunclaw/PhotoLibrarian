<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PhotoLibrarian.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <Platforms>x64;ARM64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLibrarian\PhotoLibrarian.csproj" />
    <ProjectReference Include="..\PhotoLibrarian.Core\PhotoLibrarian.Core.csproj" />
    <ProjectReference Include="..\PhotoLibrarian.ML\PhotoLibrarian.ML.csproj" />
    <ProjectReference Include="..\..\tools\PhotoLibrarian.ModelBench\PhotoLibrarian.ModelBench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PhotoLibrarian\Controls\VirtualizingPhotoGrid.xaml.cs"
          Link="TestAssets\VirtualizingPhotoGrid.xaml.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\ImageGridView.xaml.cs"
          Link="TestAssets\ImageGridView.xaml.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\MetadataPanel.xaml"
          Link="TestAssets\MetadataPanel.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\FolderNavigationPanel.xaml"
          Link="TestAssets\FolderNavigationPanel.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\ImageEditorView.xaml"
          Link="TestAssets\ImageEditorView.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\RawDerivativeExportDialog.xaml"
          Link="TestAssets\RawDerivativeExportDialog.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\ImageViewerOverlay.xaml"
          Link="TestAssets\ImageViewerOverlay.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\TopRibbon.xaml"
          Link="TestAssets\TopRibbon.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PhotoLibrarian\Views\VideoStabilizationDialog.xaml"
          Link="TestAssets\VideoStabilizationDialog.xaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\WaveletNoiseReductionExperiment.cso"
                      LogicalName="PhotoLibrarian.Tests.WaveletNoiseReductionExperiment.cso" />
    <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\MultiscaleLocalContrastExperiment.cso"
                      LogicalName="PhotoLibrarian.Tests.MultiscaleLocalContrastExperiment.cso" />
  </ItemGroup>

  <Target Name="CompileWaveletNoiseReductionExperimentShader" BeforeTargets="PrepareResources"
          Inputs="Assets\WaveletNoiseReductionExperiment.hlsl;$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)Shaders\WaveletNoiseReductionExperiment.cso">
    <PropertyGroup>
      <_ShaderSdkRoot Condition="'$(WindowsSdkDir)' != ''">$(WindowsSdkDir)</_ShaderSdkRoot>
      <_ShaderSdkRoot Condition="'$(_ShaderSdkRoot)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\</_ShaderSdkRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ShaderCompiler Include="$(_ShaderSdkRoot)\bin\*\$(WindowsSDKBuildToolsArchFolder)\fxc.exe" />
    </ItemGroup>
    <PropertyGroup>
      <_ShaderCompilerPaths>@(_ShaderCompiler)</_ShaderCompilerPaths>
      <FxcPath Condition="'$(FxcPath)' == '' AND '$(_ShaderCompilerPaths)' != ''">$(_ShaderCompilerPaths.Split(';')[0])</FxcPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(FxcPath)')" Text="Install the Windows SDK shader compiler (fxc.exe), or set FxcPath to its location." />
    <MakeDir Directories="$(IntermediateOutputPath)Shaders" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T ps_4_0 /E main /O3 /Fo &quot;$(IntermediateOutputPath)Shaders\WaveletNoiseReductionExperiment.cso&quot; &quot;$(MSBuildProjectDirectory)\Assets\WaveletNoiseReductionExperiment.hlsl&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Shaders\WaveletNoiseReductionExperiment.cso" />
    </ItemGroup>
  </Target>
  <Target Name="CompileMultiscaleLocalContrastExperimentShader" BeforeTargets="PrepareResources"
          Inputs="Assets\MultiscaleLocalContrastExperiment.hlsl;$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)Shaders\MultiscaleLocalContrastExperiment.cso">
    <PropertyGroup>
      <_ShaderSdkRoot Condition="'$(WindowsSdkDir)' != ''">$(WindowsSdkDir)</_ShaderSdkRoot>
      <_ShaderSdkRoot Condition="'$(_ShaderSdkRoot)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\</_ShaderSdkRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ShaderCompiler Include="$(_ShaderSdkRoot)\bin\*\$(WindowsSDKBuildToolsArchFolder)\fxc.exe" />
    </ItemGroup>
    <PropertyGroup>
      <_ShaderCompilerPaths>@(_ShaderCompiler)</_ShaderCompilerPaths>
      <FxcPath Condition="'$(FxcPath)' == '' AND '$(_ShaderCompilerPaths)' != ''">$(_ShaderCompilerPaths.Split(';')[0])</FxcPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(FxcPath)')" Text="Install the Windows SDK shader compiler (fxc.exe), or set FxcPath to its location." />
    <MakeDir Directories="$(IntermediateOutputPath)Shaders" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T ps_4_0 /E main /O3 /Fo &quot;$(IntermediateOutputPath)Shaders\MultiscaleLocalContrastExperiment.cso&quot; &quot;$(MSBuildProjectDirectory)\Assets\MultiscaleLocalContrastExperiment.hlsl&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Shaders\MultiscaleLocalContrastExperiment.cso" />
    </ItemGroup>
  </Target>
</Project>
