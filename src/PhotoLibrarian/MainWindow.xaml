<Window
    x:Class="PhotoLibrarian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="PhotoLibrarian">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top ribbon (shown when viewer is open) -->
        <views:TopRibbon x:Name="TopRibbon" Grid.Row="0" Visibility="Collapsed" />

        <!-- Main 3-panel layout -->
        <Grid x:Name="MainLayout" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: Folder Navigation -->
            <views:FolderNavigationPanel x:Name="FolderNavPanel" Grid.Column="0" />

            <!-- Resizable splitter -->
            <controls:GridSplitter Grid.Column="1" 
                                   Width="12"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent"
                                   HorizontalAlignment="Stretch" />

            <!-- Center: Image Grid with Viewer Overlay -->
            <Grid Grid.Column="2">
                <views:ImageGridView x:Name="ImageGridPanel" />
                
                <!-- Overlay: Image Viewer (only over grid area) -->
                <views:ImageViewerOverlay x:Name="ViewerOverlay" 
                                           Visibility="Collapsed" />
            </Grid>

            <!-- Resizable splitter -->
            <controls:GridSplitter Grid.Column="3" 
                                   Width="12"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Auto"
                                   Background="Transparent"
                                   HorizontalAlignment="Stretch" />

            <!-- Right: Metadata Panel -->
            <views:MetadataPanel x:Name="MetadataDetailPanel" Grid.Column="4" />
        </Grid>

        <!-- Overlay: Image Editor -->
        <views:ImageEditorView x:Name="EditorOverlay" Grid.Row="0" Grid.RowSpan="2"
                                Visibility="Collapsed" />

        <!-- Overlay: Settings Panel -->
        <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MaxWidth="700"
                    Margin="40"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <views:SettingsPanel x:Name="SettingsPanel" />
            </Border>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" 
                       Text="Ready"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
            <ProgressRing x:Name="IndexingProgress" 
                          Grid.Column="1"
                          IsActive="False"
                          Width="16" Height="16" 
                          Margin="0,0,8,0" />
            <Button x:Name="SettingsButton" 
                    Grid.Column="2"
                    Click="OnSettingsClick"
                    Padding="8,4"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
            <Button x:Name="BenchmarkButton" 
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Click="OnBenchmarkClick"
                    Padding="8,4"
                    ToolTipService.ToolTip="Run Benchmark">
                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</Window>
