<Window
    x:Class="PhotoLibrarian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    Title="PhotoLibrarian">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="300" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Left: Folder Navigation -->
        <views:FolderNavigationPanel Grid.Column="0" />

        <!-- Resizer -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Center: Image Grid / Viewer -->
        <views:ImageGridView Grid.Column="2" />

        <!-- Resizer -->
        <Border Grid.Column="3" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Right: Metadata / Details Panel -->
        <views:MetadataPanel Grid.Column="4" />
    </Grid>
</Window>
