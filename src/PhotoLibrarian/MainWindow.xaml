<Window
    x:Class="PhotoLibrarian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    Title="PhotoLibrarian">

    <Grid>
        <!-- Main 3-panel layout -->
        <Grid x:Name="MainLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: Folder Navigation -->
            <views:FolderNavigationPanel x:Name="FolderNavPanel" Grid.Column="0" />

            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Center: Image Grid -->
            <views:ImageGridView x:Name="ImageGridPanel" Grid.Column="2" />

            <Border Grid.Column="3" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Right: Metadata Panel -->
            <views:MetadataPanel x:Name="MetadataDetailPanel" Grid.Column="4" />
        </Grid>

        <!-- Overlay: Full-screen Image Viewer -->
        <views:ImageViewerOverlay x:Name="ViewerOverlay" 
                                   Visibility="Collapsed" />

        <!-- Status bar at bottom -->
        <Grid VerticalAlignment="Bottom" Padding="12,6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" 
                       Text="Ready"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
            <ProgressRing x:Name="IndexingProgress" 
                          Grid.Column="1"
                          IsActive="False"
                          Width="16" Height="16" />
        </Grid>
    </Grid>
</Window>
