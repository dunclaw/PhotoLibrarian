<ContentDialog
    x:Class="PhotoLibrarian.Views.VideoEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="VideoEditDialog"
    AutomationProperties.AutomationId="VideoEditDialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnExport"
    Closing="OnClosing"
    Closed="OnClosed">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="320">
            <MediaPlayerElement x:Name="Preview" x:Uid="VideoEditPreview" Height="240" AreTransportControlsEnabled="True"
                                AutoPlay="False" AutomationProperties.AutomationId="VideoEditPreview" />
            <ContentControl x:Name="OptionsPanel" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <ComboBox x:Name="RotationBox" x:Uid="VideoEditRotation" SelectedIndex="0"
                          SelectionChanged="OnOptionsChanged"
                          AutomationProperties.AutomationId="VideoEditRotation">
                    <ComboBoxItem x:Uid="VideoEditRotationNone" />
                    <ComboBoxItem x:Uid="VideoEditRotation90" />
                    <ComboBoxItem x:Uid="VideoEditRotation180" />
                    <ComboBoxItem x:Uid="VideoEditRotation270" />
                </ComboBox>
                <CheckBox x:Name="RemoveAudioBox" x:Uid="VideoEditRemoveAudio"
                          Checked="OnOptionsChanged" Unchecked="OnOptionsChanged"
                          AutomationProperties.AutomationId="VideoEditRemoveAudio" />
                <Button x:Name="PrepareButton" x:Uid="VideoEditPrepare" Click="OnPrepare" IsEnabled="False"
                        AutomationProperties.AutomationId="VideoEditPrepare" />
                <TextBox x:Name="OutputBox" x:Uid="VideoEditOutput"
                         AutomationProperties.AutomationId="VideoEditOutput" />
                <Button x:Uid="VideoEditChooseFolder" Click="OnChooseFolder"
                        AutomationProperties.AutomationId="VideoEditChooseFolder" />
              </StackPanel>
            </ContentControl>
            <TextBlock x:Uid="VideoEditNotice" TextWrapping="Wrap" />
            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Visibility="Collapsed"
                         x:Uid="VideoEditProgress" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <InfoBar x:Name="ErrorBar" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
