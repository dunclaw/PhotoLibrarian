<UserControl
    x:Class="PhotoLibrarian.Views.ImageViewerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    KeyDown="OnKeyDown">

    <Grid>
        <!-- Top bar -->
        <Grid VerticalAlignment="Top" Padding="12,8" Canvas.ZIndex="1"
              Background="#CC000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TitleText" Foreground="White"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="IndexText" Foreground="#99FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Click="OnZoomOut" ToolTipService.ToolTip="Zoom out" Padding="8">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" Foreground="White" />
                </Button>
                <Button Click="OnZoomFit" ToolTipService.ToolTip="Fit to window" Padding="8">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" Foreground="White" />
                </Button>
                <Button Click="OnZoomIn" ToolTipService.ToolTip="Zoom in" Padding="8">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" Foreground="White" />
                </Button>
                <Button Click="OnClose" ToolTipService.ToolTip="Close (Escape)" Padding="8"
                        Margin="12,0,0,0">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Image with zoom/pan -->
        <ScrollViewer x:Name="ImageScrollViewer"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.1"
                      MaxZoomFactor="10"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
            <Image x:Name="FullImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </ScrollViewer>

        <!-- Video player (shown instead of Image for videos) -->
        <MediaPlayerElement x:Name="VideoPlayer"
                            Visibility="Collapsed"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

        <!-- Navigation arrows -->
        <Button VerticalAlignment="Center" HorizontalAlignment="Left"
                Click="OnPrevious" Margin="12" Padding="12"
                Opacity="0.7" ToolTipService.ToolTip="Previous (Left arrow)">
            <FontIcon Glyph="&#xE76B;" FontSize="20" />
        </Button>
        <Button VerticalAlignment="Center" HorizontalAlignment="Right"
                Click="OnNext" Margin="12" Padding="12"
                Opacity="0.7" ToolTipService.ToolTip="Next (Right arrow)">
            <FontIcon Glyph="&#xE76C;" FontSize="20" />
        </Button>
    </Grid>
</UserControl>
