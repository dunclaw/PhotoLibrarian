<UserControl
    x:Class="PhotoLibrarian.Views.ImageViewerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoLibrarian.Views"
    Background="Black"
    KeyDown="OnKeyDown">

    <Grid x:Name="RootGrid" Background="Black">
        <!-- Top bar -->
        <Grid VerticalAlignment="Top" Padding="12,8" Canvas.ZIndex="1"
              Background="#CC000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TitleText" Foreground="White"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="IndexText" Foreground="#99FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Click="OnZoomOut" ToolTipService.ToolTip="Zoom out" Padding="8">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" Foreground="White" />
                </Button>
                <Button Click="OnZoomFit" ToolTipService.ToolTip="Fit to window" Padding="8">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" Foreground="White" />
                </Button>
                <Button Click="OnZoomIn" ToolTipService.ToolTip="Zoom in" Padding="8">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" Foreground="White" />
                </Button>
                <Button Click="OnClose" ToolTipService.ToolTip="Close (Escape)" Padding="8"
                        Margin="12,0,0,0">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Image viewer with zoom/pan -->
        <ScrollViewer x:Name="ImageScrollViewer"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      SizeChanged="ImageScrollViewer_SizeChanged"
                      PointerPressed="ImageScrollViewer_PointerPressed"
                      PointerMoved="ImageScrollViewer_PointerMoved"
                      PointerReleased="ImageScrollViewer_PointerReleased"
                      PointerCanceled="ImageScrollViewer_PointerCanceled">
            <Canvas x:Name="ScrollContent">
                <Grid x:Name="ImageHost">
                    <Image x:Name="FullImage" Stretch="Uniform" />
                    <views:CropOverlay x:Name="CropOverlayView" Visibility="Collapsed" />
                </Grid>
            </Canvas>
        </ScrollViewer>

        <!-- Video player (shown instead of Image for videos) -->
        <MediaPlayerElement x:Name="VideoPlayer"
                            Visibility="Collapsed"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

        <!-- Navigation arrows -->
        <Button VerticalAlignment="Center" HorizontalAlignment="Left"
                Click="OnPrevious" Margin="12" Padding="12"
                Opacity="0.7" ToolTipService.ToolTip="Previous (Left arrow)">
            <FontIcon Glyph="&#xE76B;" FontSize="20" />
        </Button>
        <Button VerticalAlignment="Center" HorizontalAlignment="Right"
                Click="OnNext" Margin="12" Padding="12"
                Opacity="0.7" ToolTipService.ToolTip="Next (Right arrow)">
            <FontIcon Glyph="&#xE76C;" FontSize="20" />
        </Button>
    </Grid>
</UserControl>
