<ContentDialog
    x:Class="PhotoLibrarian.Views.VideoTrimDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="VideoTrimDialog"
    AutomationProperties.AutomationId="VideoTrimDialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnExportClick"
    Opened="OnOpened"
    Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="360">
            <TextBlock x:Uid="VideoTrimIntro"
                       TextWrapping="Wrap" />
            <ContentControl x:Name="OptionsPanel"
                            HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="VideoTrimStartLabel"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StartTimeText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <Slider x:Name="StartSlider"
                            AutomationProperties.AutomationId="VideoTrimStartSlider"
                            x:Uid="VideoTrimStartSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            StepFrequency="0.03"
                            IsEnabled="False"
                            ValueChanged="OnStartSliderChanged" />
                    <NumberBox x:Name="StartSeconds"
                               AutomationProperties.AutomationId="VideoTrimStartSeconds"
                               x:Uid="VideoTrimStartSeconds"
                               Value="0"
                               Minimum="0"
                               Maximum="1"
                               SmallChange="0.03"
                               LargeChange="1"
                               SpinButtonPlacementMode="Inline"
                               ValidationMode="InvalidInputOverwritten"
                               IsEnabled="False"
                               ValueChanged="OnStartSecondsChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="VideoTrimEndLabel"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="EndTimeText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <Slider x:Name="EndSlider"
                            AutomationProperties.AutomationId="VideoTrimEndSlider"
                            x:Uid="VideoTrimEndSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="1"
                            StepFrequency="0.03"
                            IsEnabled="False"
                            ValueChanged="OnEndSliderChanged" />
                    <NumberBox x:Name="EndSeconds"
                               AutomationProperties.AutomationId="VideoTrimEndSeconds"
                               x:Uid="VideoTrimEndSeconds"
                               Value="1"
                               Minimum="0"
                               Maximum="1"
                               SmallChange="0.03"
                               LargeChange="1"
                               SpinButtonPlacementMode="Inline"
                               ValidationMode="InvalidInputOverwritten"
                               IsEnabled="False"
                               ValueChanged="OnEndSecondsChanged" />
                </StackPanel>
                </Grid>
                <TextBox x:Name="OutputBox"
                         AutomationProperties.AutomationId="VideoTrimOutput"
                         x:Uid="VideoTrimOutput" />
                <Button x:Name="ChooseFolderButton"
                        AutomationProperties.AutomationId="VideoTrimChooseFolder"
                        x:Uid="VideoTrimChooseFolder"
                        Click="OnChooseFolder" />
              </StackPanel>
            </ContentControl>
            <TextBlock x:Uid="VideoTrimPolicy"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="ExportProgress"
                         x:Uid="VideoTrimProgress"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       x:Uid="VideoTrimStatus"
                       AutomationProperties.LiveSetting="Polite"
                       TextWrapping="Wrap" />
            <InfoBar x:Name="ResultBar"
                     x:Uid="VideoTrimError"
                     IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
