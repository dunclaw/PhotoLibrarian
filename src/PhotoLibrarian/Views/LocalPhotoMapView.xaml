<UserControl
    x:Class="PhotoLibrarian.Views.LocalPhotoMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoLibrarian.Views">
    <Grid Padding="8" RowSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="PhotoMapTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Uid="PhotoMapDisclaimer" Grid.Row="1" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Uid="PhotoMapFit" AutomationProperties.AutomationId="PhotoMapFit"
                            Click="OnNavigate" Tag="Fit" />
                    <Button x:Uid="PhotoMapZoomIn" AutomationProperties.AutomationId="PhotoMapZoomIn"
                            Click="OnNavigate" Tag="In" />
                    <Button x:Uid="PhotoMapZoomOut" AutomationProperties.AutomationId="PhotoMapZoomOut"
                            Click="OnNavigate" Tag="Out" />
                    <Button x:Name="ClearButton" x:Uid="PhotoMapClear"
                            AutomationProperties.AutomationId="PhotoMapClear"
                            Click="OnClear" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Uid="PhotoMapWest" AutomationProperties.AutomationId="PhotoMapWest"
                            Click="OnNavigate" Tag="West" />
                    <Button x:Uid="PhotoMapEast" AutomationProperties.AutomationId="PhotoMapEast"
                            Click="OnNavigate" Tag="East" />
                    <Button x:Uid="PhotoMapNorth" AutomationProperties.AutomationId="PhotoMapNorth"
                            Click="OnNavigate" Tag="North" />
                    <Button x:Uid="PhotoMapSouth" AutomationProperties.AutomationId="PhotoMapSouth"
                            Click="OnNavigate" Tag="South" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Canvas x:Name="MapCanvas" SizeChanged="OnMapSizeChanged"
                        FlowDirection="LeftToRight"
                        Background="{ThemeResource ControlFillColorDefaultBrush}" />
            </Border>
            <ListView x:Name="GroupList" x:Uid="PhotoMapGroups"
                      AutomationProperties.AutomationId="PhotoMapGroups"
                      Grid.Column="1" SelectionMode="Single"
                      SelectionChanged="OnGroupSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoMapGroup">
                        <TextBlock Text="{x:Bind Label, Mode=OneTime}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <TextBlock x:Name="Summary" Grid.Row="4" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="PhotoMapSummary"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
