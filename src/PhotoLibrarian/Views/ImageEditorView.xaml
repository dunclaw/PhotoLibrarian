<UserControl
    x:Class="PhotoLibrarian.Views.ImageEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <!-- UserControl.Background is not rendered, so the opaque surface lives on the root Grid
         to keep the viewer and metadata panel underneath from showing through. -->
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Win2D Canvas for real-time preview -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Padding="12,8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PreviousBtn" Click="OnPrevious" Padding="8"
                            AutomationProperties.Name="Previous photo" AutomationProperties.AutomationId="EditorPrevious"
                            ToolTipService.ToolTip="Previous photo (Ctrl+Page Up)">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                    </Button>
                    <Button x:Name="NextBtn" Click="OnNext" Padding="8"
                            AutomationProperties.Name="Next photo" AutomationProperties.AutomationId="EditorNext"
                            ToolTipService.ToolTip="Next photo (Ctrl+Page Down)">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                    </Button>
                    <AppBarSeparator />
                    <SplitButton x:Name="UndoBtn" Click="OnUndo" IsEnabled="False"
                                 AutomationProperties.Name="Undo edit" AutomationProperties.AutomationId="EditorUndo"
                                 ToolTipService.ToolTip="Undo edit">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="UndoFlyout" Opening="OnHistoryOpening" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton x:Name="RedoBtn" Click="OnRedo" IsEnabled="False"
                                 AutomationProperties.Name="Redo edit" AutomationProperties.AutomationId="EditorRedo"
                                 ToolTipService.ToolTip="Redo edit">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="RedoFlyout" Opening="OnHistoryOpening" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <AppBarSeparator />
                    <Button Click="OnZoomOut" ToolTipService.ToolTip="Zoom out (Ctrl+-)" Padding="8"
                            AutomationProperties.Name="Zoom out">
                        <FontIcon Glyph="&#xE71F;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="ZoomText" MinWidth="48" TextAlignment="Center"
                               VerticalAlignment="Center" Text="Fit"
                               AutomationProperties.Name="Zoom level" />
                    <Button Click="OnZoomIn" ToolTipService.ToolTip="Zoom in (Ctrl++)" Padding="8"
                            AutomationProperties.Name="Zoom in">
                        <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                    </Button>
                    <Button Click="OnZoomFit" ToolTipService.ToolTip="Fit to window (Ctrl+0)" Padding="8"
                            AutomationProperties.Name="Fit to window">
                        <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                    </Button>
                    <Button Click="OnZoomActual" ToolTipService.ToolTip="Actual size (Ctrl+1)" Padding="8"
                            AutomationProperties.Name="Actual size">
                        <FontIcon Glyph="&#xE71E;" FontSize="14" />
                    </Button>
                    <AppBarSeparator />
                    <Button x:Name="SaveBtn" Click="OnSave" ToolTipService.ToolTip="Save edits" Padding="8"
                            AutomationProperties.Name="Save edits" AutomationProperties.AutomationId="EditorSave">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>
                    <Button x:Name="CloseBtn" Click="OnClose" ToolTipService.ToolTip="Close editor" Padding="8"
                            AutomationProperties.Name="Close editor">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <canvas:CanvasControl x:Name="EditCanvas" Grid.Row="1" Margin="16"
                                   AutomationProperties.Name="Edit preview"
                                   Draw="OnCanvasDraw"
                                   CreateResources="OnCanvasCreateResources"
                                   SizeChanged="OnEditCanvasSizeChanged"
                                   PointerWheelChanged="OnEditCanvasPointerWheelChanged"
                                   PointerPressed="OnEditCanvasPointerPressed"
                                   PointerMoved="OnEditCanvasPointerMoved"
                                   PointerReleased="OnEditCanvasPointerReleased"
                                   PointerCanceled="OnEditCanvasPointerReleased"
                                   PointerCaptureLost="OnEditCanvasPointerCaptureLost"
                                   DoubleTapped="OnEditCanvasDoubleTapped" />
        </Grid>

        <!-- Adjustment sliders panel -->
        <ScrollViewer x:Name="AdjustmentsPanel" Grid.Column="1" Padding="12"
                      Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="1,0,0,0">
            <StackPanel Spacing="12">
                <TextBlock Text="Adjustments" Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- Quick actions -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="AutoBtn" Content="Auto" Click="OnAutoEnhance" Padding="8,4" />
                    <Button x:Name="ResetBtn" Content="Reset" Click="OnReset" Padding="8,4"
                            AutomationProperties.AutomationId="EditorReset" />
                    <Button x:Name="RevertBtn" Content="Revert" Click="OnRevert" Padding="8,4"
                            Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="RawPreviewPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="RawPreviewStatus" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="EditorRawPreviewStatus"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Exposure (stops)" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="RawExposureText" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="RawExposureSlider"
                            AutomationProperties.Name="RAW exposure in stops"
                            AutomationProperties.AutomationId="EditorRawExposure"
                            Minimum="-8" Maximum="8" StepFrequency="0.1" SmallChange="0.1"
                            Value="0" ValueChanged="OnRawSliderChanged" />
                    <TextBlock Text="Scene white point" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="RawWhitePointText" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="RawWhitePointSlider"
                            AutomationProperties.Name="RAW scene white point"
                            AutomationProperties.AutomationId="EditorRawWhitePoint"
                            Minimum="1" Maximum="16" StepFrequency="0.1" SmallChange="0.1"
                            ToolTipService.ToolTip="Scene-linear luminance mapped to SDR white after exposure. Higher values retain more unsaturated highlight range."
                            Value="4" ValueChanged="OnRawSliderChanged" />
                    <Button x:Name="KeepRecipeBtn" Content="Keep preview recipe" Click="OnKeepRawRecipe"
                            AutomationProperties.Name="Keep RAW preview recipe in an XMP sidecar"
                            AutomationProperties.AutomationId="EditorKeepRawRecipe" />
                    <Button x:Name="ExportRawBtn" Content="Export SDR derivative..." Click="OnExportRaw"
                            AutomationProperties.Name="Export RAW development as a separate SDR JPEG or PNG"
                            AutomationProperties.AutomationId="EditorExportRawDerivative" />
                    <Button x:Name="CancelRawExportBtn" Content="Cancel export" Click="OnCancelRawExport"
                            Visibility="Collapsed" AutomationProperties.Name="Cancel RAW derivative export"
                            AutomationProperties.AutomationId="EditorCancelRawExport" />
                    <TextBlock Text="Only these RAW controls apply. Existing raster adjustments are retained in the recipe but not applied to RAW."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <StackPanel x:Name="RasterAdjustmentsPanel" Spacing="12">
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Tone section -->
                <TextBlock Text="Tone" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Exposure" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ExposureSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Brightness" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Contrast" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ContrastSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Highlights" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="HighlightsSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Shadows" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ShadowsSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Color section -->
                <TextBlock Text="Color" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Saturation" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="SaturationSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Temperature" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="TemperatureSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Tint" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="TintSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Detail section -->
                <TextBlock Text="Detail" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Noise reduction" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="NoiseReductionSlider"
                            AutomationProperties.Name="Noise reduction"
                            AutomationProperties.AutomationId="EditorNoiseReduction"
                            Minimum="0" Maximum="1" StepFrequency="0.01" SmallChange="0.01"
                            ToolTipService.ToolTip="Smooth noise while retaining strong edges. Higher values can soften fine texture."
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Clarity" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ClaritySlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            TickFrequency="1" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel x:Name="SharpeningPanel" Spacing="8">
                    <TextBlock Text="Sharpening" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <CheckBox x:Name="AdvancedSharpeningCheckBox"
                              AutomationProperties.Name="Advanced sharpening"
                              AutomationProperties.AutomationId="EditorAdvancedSharpening"
                              Content="Advanced"
                              Checked="OnAdvancedSharpeningChanged"
                              Unchecked="OnAdvancedSharpeningChanged" />
                    <StackPanel x:Name="BasicSharpeningPanel" Spacing="4">
                        <TextBlock Text="Amount" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="SharpnessSlider"
                                AutomationProperties.Name="Sharpening amount"
                                AutomationProperties.AutomationId="EditorSharpness"
                                Minimum="0" Maximum="1" StepFrequency="0.01"
                                ToolTipService.ToolTip="Increase edge contrast to make details look sharper."
                                Value="0" ValueChanged="OnSliderChanged" />
                    </StackPanel>
                    <StackPanel x:Name="UnsharpMaskPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Increases edge contrast; it does not recover lost detail."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Amount" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="UnsharpMaskAmountText" Grid.Column="1"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <Slider x:Name="UnsharpMaskAmountSlider"
                                    AutomationProperties.Name="Advanced sharpening amount"
                                    AutomationProperties.AutomationId="EditorUnsharpAmount"
                                    Minimum="0" Maximum="2" StepFrequency="0.01"
                                    Value="0" ValueChanged="OnSliderChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Radius (pixels)" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="UnsharpMaskRadiusText" Grid.Column="1"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <Slider x:Name="UnsharpMaskRadiusSlider"
                                    AutomationProperties.Name="Sharpening radius in pixels"
                                    AutomationProperties.AutomationId="EditorUnsharpRadius"
                                    Minimum="0.5" Maximum="5" StepFrequency="0.1"
                                    ToolTipService.ToolTip="Set how far sharpening extends around edges, measured in original image pixels."
                                    Value="1" ValueChanged="OnSliderChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Noise threshold" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="UnsharpMaskThresholdText" Grid.Column="1"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <Slider x:Name="UnsharpMaskThresholdSlider"
                                    AutomationProperties.Name="Sharpening noise threshold"
                                    AutomationProperties.AutomationId="EditorUnsharpThreshold"
                                    Minimum="0" Maximum="0.25" StepFrequency="0.005"
                                    ToolTipService.ToolTip="Raise this to avoid sharpening small differences such as noise."
                                    Value="0.02" ValueChanged="OnSliderChanged" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Levels section -->
                <TextBlock Text="Levels" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <canvas:CanvasControl x:Name="HistogramCanvas"
                                      Height="112"
                                      Draw="OnHistogramDraw"
                                      PointerPressed="OnHistogramPointerPressed"
                                      PointerMoved="OnHistogramPointerMoved"
                                      PointerReleased="OnHistogramPointerReleased"
                                      PointerCanceled="OnHistogramPointerCanceled"
                                      PointerCaptureLost="OnHistogramPointerCanceled" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Black Point" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="BlackPointSlider" Minimum="0" Maximum="0.5" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="White Point" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="WhitePointSlider" Minimum="0.5" Maximum="1" StepFrequency="0.01"
                            Value="1" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Midtones" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="MidtonesSlider" Minimum="0.1" Maximum="0.9" StepFrequency="0.01"
                            TickFrequency="0.4" TickPlacement="Inline"
                            Value="0.5" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Rotation -->
                <TextBlock Text="Transform" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="Rotation" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" StepFrequency="0.5"
                            TickFrequency="180" TickPlacement="Inline"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
