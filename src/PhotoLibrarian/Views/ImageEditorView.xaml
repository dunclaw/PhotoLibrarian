<UserControl
    x:Class="PhotoLibrarian.Views.ImageEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Win2D Canvas for real-time preview -->
        <Grid Grid.Column="0">
            <!-- Top bar -->
            <Grid VerticalAlignment="Top" Padding="12,8" Canvas.ZIndex="1"
                  Background="#CC000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Foreground="White"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnSave" ToolTipService.ToolTip="Save edits" Padding="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="White" />
                    </Button>
                    <Button Click="OnClose" ToolTipService.ToolTip="Close editor" Padding="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>

            <canvas:CanvasControl x:Name="EditCanvas"
                                   Draw="OnCanvasDraw"
                                   CreateResources="OnCanvasCreateResources" />
        </Grid>

        <!-- Adjustment sliders panel -->
        <ScrollViewer Grid.Column="1" Padding="12"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="Adjustments" Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- Quick actions -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Auto" Click="OnAutoEnhance" Padding="8,4" />
                    <Button Content="Reset" Click="OnReset" Padding="8,4" />
                    <Button x:Name="RevertBtn" Content="Revert" Click="OnRevert" Padding="8,4"
                            Visibility="Collapsed" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Tone section -->
                <TextBlock Text="Tone" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Exposure" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ExposureSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Brightness" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Contrast" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ContrastSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Highlights" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="HighlightsSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Shadows" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ShadowsSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Color section -->
                <TextBlock Text="Color" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Saturation" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="SaturationSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Temperature" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="TemperatureSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Tint" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="TintSlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Detail section -->
                <TextBlock Text="Detail" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Clarity" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="ClaritySlider" Minimum="-1" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Sharpness" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Levels section -->
                <TextBlock Text="Levels" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Black Point" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="BlackPointSlider" Minimum="0" Maximum="0.5" StepFrequency="0.01"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="White Point" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="WhitePointSlider" Minimum="0.5" Maximum="1" StepFrequency="0.01"
                            Value="1" ValueChanged="OnSliderChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Midtones" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="MidtonesSlider" Minimum="0.1" Maximum="0.9" StepFrequency="0.01"
                            Value="0.5" ValueChanged="OnSliderChanged" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Rotation -->
                <TextBlock Text="Transform" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="Rotation" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" StepFrequency="0.5"
                            Value="0" ValueChanged="OnSliderChanged" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
