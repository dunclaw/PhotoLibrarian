<UserControl
    x:Class="PhotoLibrarian.Views.SidecarMigrationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="320" MaxWidth="640" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="MigrationNotice"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText"
                   AutomationProperties.LiveSetting="Polite"
                   Grid.Row="1"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   TextWrapping="Wrap" />
        <ProgressBar x:Uid="MigrationProgress"
                     Grid.Row="2"
                     IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                     Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
        <ListView x:Uid="MigrationResults"
                  AutomationProperties.AutomationId="MigrationResults"
                  Grid.Row="3"
                  MinHeight="160" MaxHeight="320"
                  ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <CheckBox x:Uid="MigrationConsent"
                  AutomationProperties.AutomationId="MigrationConsent"
                  Grid.Row="4"
                  IsChecked="{x:Bind ViewModel.Consent, Mode=TwoWay}"
                  IsEnabled="{x:Bind ViewModel.CanMigrate, Mode=OneWay}" />
        <Button x:Uid="MigrationCancel"
                AutomationProperties.AutomationId="MigrationCancel"
                Grid.Row="5"
                Command="{x:Bind ViewModel.CancelCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</UserControl>
