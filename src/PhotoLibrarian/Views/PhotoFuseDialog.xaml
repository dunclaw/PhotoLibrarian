<ContentDialog
    x:Class="PhotoLibrarian.Views.PhotoFuseDialog"
    x:Uid="FuseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Photo Fuse"
    PrimaryButtonText="Save new PNG"
    CloseButtonText="Close"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnSave"
    Closing="OnClosing">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
    </ContentDialog.Resources>
    <Grid RowSpacing="12" MinWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="FuseSafety" Text="Choose regions from aligned burst stills. Sources are never changed. The new sRGB PNG is at most 1600 pixels on its longest edge; tags, GPS and people identities are not copied."
                   TextWrapping="Wrap" />
        <InfoBar x:Name="ResultBar" x:Uid="FuseInitialStatus" Grid.Row="1" IsOpen="True" IsClosable="False"
                 AutomationProperties.AutomationId="FuseStatus"
                 Severity="Informational" Message="Preparing burst..." />
        <ContentControl x:Name="Workspace" Grid.Row="2" IsEnabled="False"
                        HorizontalContentAlignment="Stretch">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          AutomationProperties.AutomationId="FuseRegionOptions"
                          AutomationProperties.Name="Region settings">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="DonorBox" x:Uid="FuseDonor" Header="Take region from"
                              AutomationProperties.AutomationId="FuseDonor"
                              ToolTipService.ToolTip="Drag on the aligned donor, or enter a rectangle in base-image pixels. Include unchanged background around a face; identities are not matched automatically."
                              HorizontalAlignment="Stretch" SelectionChanged="OnDonorChanged" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox x:Name="LeftBox" x:Uid="FuseLeft" Header="Left" Minimum="0" Value="48"
                                   AutomationProperties.AutomationId="FuseLeft" ValueChanged="OnRectangleChanged" />
                        <NumberBox x:Name="TopBox" x:Uid="FuseTop" Grid.Column="1" Header="Top" Minimum="0" Value="48"
                                   AutomationProperties.AutomationId="FuseTop" ValueChanged="OnRectangleChanged" />
                        <NumberBox x:Name="WidthBox" x:Uid="FuseWidth" Grid.Row="1" Header="Width" Minimum="16" Value="96"
                                   AutomationProperties.AutomationId="FuseWidth" ValueChanged="OnRectangleChanged" />
                        <NumberBox x:Name="HeightBox" x:Uid="FuseHeight" Grid.Row="1" Grid.Column="1" Header="Height" Minimum="16" Value="96"
                                   AutomationProperties.AutomationId="FuseHeight" ValueChanged="OnRectangleChanged" />
                    </Grid>
                    <ListView x:Name="RegionsList" MaxHeight="128" SelectionMode="Single"
                              AutomationProperties.AutomationId="FuseRegions"
                              AutomationProperties.Name="Chosen regions" />
                </StackPanel>
            </ScrollViewer>
                <StackPanel Grid.Row="1" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="FuseAdd" Content="Add region" Click="OnAddRegion"
                                AutomationProperties.AutomationId="FuseAddRegion" />
                        <Button x:Uid="FuseRemove" Content="Remove region" Click="OnRemoveRegion"
                                AutomationProperties.AutomationId="FuseRemoveRegion" />
                    </StackPanel>
                    <Button x:Uid="FuseBuild" Content="Build composite preview" Click="OnBuildPreview"
                            HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FuseBuildPreview" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DisplayBox" SelectedIndex="0" SelectionChanged="OnDisplayChanged"
                              AutomationProperties.AutomationId="FuseDisplay" AutomationProperties.Name="Preview image">
                        <ComboBoxItem x:Uid="FuseAlignedDonor" Content="Aligned donor" />
                        <ComboBoxItem x:Uid="FuseBase" Content="Base image" />
                        <ComboBoxItem x:Uid="FuseComposite" Content="Composite preview" />
                    </ComboBox>
                    <Button x:Uid="FuseFit" Content="Fit" Click="OnFit" AutomationProperties.AutomationId="FuseFit" />
                    <Button Content="1:1" Click="OnActualPixels" AutomationProperties.AutomationId="FuseActualPixels"
                            AutomationProperties.Name="Review at actual pixels" />
                </StackPanel>
                <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" MaxHeight="360"
                              SizeChanged="OnPreviewSizeChanged"
                              ViewChanged="OnPreviewViewChanged"
                              AutomationProperties.AutomationId="FusePreviewScroll" AutomationProperties.Name="Zoomed photo preview"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8">
                    <Grid x:Name="PreviewSurface" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved"
                          PointerReleased="OnPointerReleased" PointerCanceled="OnPointerCanceled">
                        <Image x:Name="PreviewImage" Stretch="Fill"
                               AutomationProperties.Name="Photo Fuse image preview" />
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="SelectionRectangle" Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                       StrokeThickness="2" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Uid="FuseOverlapHelp" Grid.Row="2" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="Aligned donor preview uses the base outside the common overlap. Regions crossing that boundary cannot be added." />
            </Grid>
        </Grid>
        </ContentControl>
        <CheckBox x:Name="ConfirmBox" x:Uid="FuseConfirm" Grid.Row="3" IsEnabled="False"
                  AutomationProperties.AutomationId="FuseConfirm"
                  Content="I reviewed this composite at 1:1, including every region and its border."
                  Checked="OnConfirmationChanged" Unchecked="OnConfirmationChanged" />
    </Grid>
</ContentDialog>
