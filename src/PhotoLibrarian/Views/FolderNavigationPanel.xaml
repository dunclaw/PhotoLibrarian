<UserControl
    x:Class="PhotoLibrarian.Views.FolderNavigationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoLibrarian.ViewModels">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Browse" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="ManageFoldersButton" ToolTipService.ToolTip="Manage library folders"
                        Click="OnManageFoldersClick" Padding="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </Button>
                <Button x:Name="RefreshButton" ToolTipService.ToolTip="Refresh"
                        Click="OnRefreshClick" Padding="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sections: Library, Date, Tags, Flags -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                
                <!-- Library Section -->
                <StackPanel>
                    <TextBlock Text="Library" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="LibraryTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnLibraryItemInvoked"
                              Expanding="OnLibraryExpanding"
                              SelectionChanged="OnLibrarySelectionChanged" />
                </StackPanel>

                <!-- Date Section -->
                <StackPanel>
                    <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="DateTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnDateItemInvoked"
                              SelectionChanged="OnDateSelectionChanged" />
                </StackPanel>

                <!-- Tags Section -->
                <StackPanel>
                    <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="TagsTree"
                              SelectionMode="Multiple"
                              CanDragItems="False"
                              CanReorderItems="False"
                              ItemInvoked="OnTagsItemInvoked"
                              SelectionChanged="OnTagsSelectionChanged"
                              AllowDrop="True"
                              DragOver="OnTagsTreeDragOver"
                              Drop="OnTagsTreeDrop" />
                </StackPanel>

                <!-- Flags Section -->
                <StackPanel>
                    <TextBlock Text="Flags" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="FlagsTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnFlagsItemInvoked"
                              SelectionChanged="OnFlagsSelectionChanged" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
