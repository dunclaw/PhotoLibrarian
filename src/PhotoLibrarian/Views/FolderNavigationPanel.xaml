<UserControl
    x:Class="PhotoLibrarian.Views.FolderNavigationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoLibrarian.ViewModels">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Browse" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="AddFolderButton" ToolTipService.ToolTip="Add folder to library"
                        Click="OnAddFolderClick" Padding="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button x:Name="RemoveFolderButton" ToolTipService.ToolTip="Remove selected folder from library"
                        Click="OnRemoveFolderClick" Padding="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button x:Name="RefreshButton" ToolTipService.ToolTip="Refresh"
                        Click="OnRefreshClick" Padding="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Three sections: Library, Date, Tags -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                
                <!-- Library Section -->
                <StackPanel>
                    <TextBlock Text="Library" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="LibraryTree"
                              SelectionMode="Multiple"
                              ItemInvoked="OnLibraryItemInvoked"
                              Expanding="OnLibraryExpanding"
                              SelectionChanged="OnLibrarySelectionChanged" />
                </StackPanel>

                <!-- Date Section -->
                <StackPanel>
                    <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="DateTree"
                              SelectionMode="Multiple"
                              SelectionChanged="OnDateSelectionChanged" />
                </StackPanel>

                <!-- Tags Section -->
                <StackPanel>
                    <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView x:Name="TagsTree"
                              SelectionMode="Multiple"
                              SelectionChanged="OnTagsSelectionChanged" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
