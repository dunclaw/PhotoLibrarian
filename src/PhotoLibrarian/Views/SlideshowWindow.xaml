<Window
    x:Class="PhotoLibrarian.Views.SlideshowWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PhotoLibrarian slideshow">
    <Grid x:Name="SlideshowRoot" RequestedTheme="Dark"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnExitInvoked" />
            <KeyboardAccelerator Key="F11" Invoked="OnExitInvoked" />
            <KeyboardAccelerator Key="Left" Invoked="OnPreviousInvoked" />
            <KeyboardAccelerator Key="Up" Invoked="OnPreviousInvoked" />
            <KeyboardAccelerator Key="Right" Invoked="OnNextInvoked" />
            <KeyboardAccelerator Key="Down" Invoked="OnNextInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}" Stretch="Uniform"
               AutomationProperties.Name="Slideshow photo" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="24"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="1" Padding="16" ColumnSpacing="16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.PhotoLabel, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Arrow keys: step photos   Esc: exit"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Grid.Column="1" Grid.RowSpan="2"
                        Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}"
                        AutomationProperties.AutomationId="SlideshowPrevious" />
                <Button Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.TogglePauseCommand}"
                        AutomationProperties.AutomationId="SlideshowPause" />
                <Button Content="Next" Command="{x:Bind ViewModel.NextCommand}"
                        AutomationProperties.AutomationId="SlideshowNext" />
                <NumberBox Value="{x:Bind ViewModel.IntervalSeconds, Mode=TwoWay}"
                           Header="Seconds per photo"
                           Minimum="1" Maximum="60" SmallChange="1"
                           SpinButtonPlacementMode="Inline" Width="144"
                           AutomationProperties.Name="Seconds per photo"
                           AutomationProperties.AutomationId="SlideshowInterval"
                           ToolTipService.ToolTip="Seconds per photo (1-60)" />
                <Button Content="Exit" Click="OnExitClick"
                        AutomationProperties.AutomationId="SlideshowExit" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
