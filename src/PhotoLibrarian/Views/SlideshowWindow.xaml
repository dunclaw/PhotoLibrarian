<Window
    x:Class="PhotoLibrarian.Views.SlideshowWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PhotoLibrarian slideshow">
    <Grid x:Name="SlideshowRoot" RequestedTheme="Dark"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnExitInvoked" />
            <KeyboardAccelerator Key="F11" Invoked="OnExitInvoked" />
            <KeyboardAccelerator Key="Left" Invoked="OnPreviousInvoked" />
            <KeyboardAccelerator Key="Up" Invoked="OnPreviousInvoked" />
            <KeyboardAccelerator Key="Right" Invoked="OnNextInvoked" />
            <KeyboardAccelerator Key="Down" Invoked="OnNextInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="ImageStage" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="CinematicTopBar" Grid.Row="0" Height="32"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed" />
            <Grid x:Name="PhotoViewport" Grid.Row="1" SizeChanged="OnPhotoViewportSizeChanged">
                <Grid x:Name="PreviousPhotoLayer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PreviousPhotoScale" />
                            <TranslateTransform x:Name="PreviousPhotoTranslation" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="PreviousPhotoImage" Stretch="Uniform"
                           AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <Grid x:Name="CurrentPhotoLayer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CurrentPhotoScale" />
                            <TranslateTransform x:Name="CurrentPhotoTranslation" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image x:Name="CurrentPhotoImage" Stretch="Uniform"
                           AutomationProperties.Name="Slideshow photo" />
                </Grid>
            </Grid>
            <Border x:Name="CinematicBottomBar" Grid.Row="2" Height="32"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="24"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid x:Name="SlideshowToolbar" Grid.Row="1" Padding="8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.PhotoLabel, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}"
                        AutomationProperties.AutomationId="SlideshowPrevious" />
                <Button Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.TogglePauseCommand}"
                        AutomationProperties.AutomationId="SlideshowPause" />
                <Button Content="Next" Command="{x:Bind ViewModel.NextCommand}"
                        AutomationProperties.AutomationId="SlideshowNext" />
                <ComboBox x:Name="ThemePicker" MinWidth="168"
                          SelectionChanged="OnThemeSelectionChanged"
                          AutomationProperties.Name="Slideshow theme"
                          AutomationProperties.AutomationId="SlideshowTheme"
                          ToolTipService.ToolTip="Change the display-only theme without leaving the slideshow">
                    <ComboBoxItem Content="Pan and Zoom" Tag="PanAndZoom" />
                    <ComboBoxItem Content="Contemporary" Tag="Contemporary" />
                    <ComboBoxItem Content="Cinematic" Tag="Cinematic" />
                    <ComboBoxItem Content="Fade" Tag="Fade" />
                    <ComboBoxItem Content="Black and White" Tag="BlackAndWhite" />
                    <ComboBoxItem Content="Sepia" Tag="Sepia" />
                </ComboBox>
                <NumberBox Value="{x:Bind ViewModel.IntervalSeconds, Mode=TwoWay}"
                           Minimum="1" Maximum="60" SmallChange="1"
                           SpinButtonPlacementMode="Compact" Width="80"
                           AutomationProperties.Name="Seconds per photo"
                           AutomationProperties.AutomationId="SlideshowInterval"
                           ToolTipService.ToolTip="Seconds per photo (1-60)" />
                <Button Content="Exit" Click="OnExitClick"
                        AutomationProperties.AutomationId="SlideshowExit" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
