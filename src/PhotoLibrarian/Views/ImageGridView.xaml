<UserControl
    x:Class="PhotoLibrarian.Views.ImageGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:PhotoLibrarian.Controls">

    <UserControl.Resources>
        <!-- Force scroll bar to always be visible and opaque -->
        <Style x:Key="AlwaysVisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        </Style>
        
        <x:Double x:Key="ScrollBarSize">18</x:Double>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Group By controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Group:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="GroupByCombo" 
                          SelectedIndex="0" 
                          MinWidth="140"
                          SelectionChanged="OnGroupByChanged">
                    <ComboBoxItem Content="None" Tag="None" />
                    <ComboBoxItem Content="File Type" Tag="FileType" />
                    <ComboBoxItem Content="Media Type" Tag="MediaType" />
                    <ComboBoxItem Content="Year Taken" Tag="YearTaken" />
                    <ComboBoxItem Content="Month Taken" Tag="MonthTaken" />
                    <ComboBoxItem Content="File Size" Tag="FileSize" />
                    <ComboBoxItem Content="Image Size" Tag="ImageSize" />
                    <ComboBoxItem Content="Rating" Tag="Rating" />
                    <ComboBoxItem Content="Camera" Tag="Camera" />
                </ComboBox>
            </StackPanel>

            <!-- Sort controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="SortByCombo" 
                          SelectedIndex="1" 
                          MinWidth="120"
                          SelectionChanged="OnSortByChanged">
                    <ComboBoxItem Content="File Name" Tag="FileName" />
                    <ComboBoxItem Content="Date Taken" Tag="DateTaken" />
                    <ComboBoxItem Content="Date Modified" Tag="DateModified" />
                    <ComboBoxItem Content="File Size" Tag="FileSize" />
                    <ComboBoxItem Content="Rating" Tag="Rating" />
                </ComboBox>
                <Button x:Name="SortOrderBtn" Click="OnToggleSortOrder" Padding="6" ToolTipService.ToolTip="Toggle sort order">
                    <FontIcon x:Name="SortOrderIcon" Glyph="&#xE014;" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Thumbnail size slider -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <Button Click="OnDecreaseSize" Padding="6" ToolTipService.ToolTip="Smaller thumbnails">
                    <FontIcon Glyph="&#xE71F;" FontSize="12" />
                </Button>
                <Slider x:Name="SizeSlider" Width="120" Minimum="100" Maximum="400" Value="180"
                        VerticalAlignment="Center" ValueChanged="OnSizeSliderChanged" />
                <Button Click="OnIncreaseSize" Padding="6" ToolTipService.ToolTip="Larger thumbnails">
                    <FontIcon Glyph="&#xE8A3;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Custom Virtualizing Photo Grid -->
        <local:VirtualizingPhotoGrid Grid.Row="1" x:Name="PhotoGrid" />

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Spacing="8">
            <FontIcon Glyph="&#xEB9F;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No photos yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Click + in the Library panel to add a folder"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
