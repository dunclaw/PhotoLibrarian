<ContentDialog
    x:Class="PhotoLibrarian.Views.VideoStabilizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="VideoStabilizationDialog"
    Title="Stabilize video"
    PrimaryButtonText="Export stabilized copy"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="OnExportClick"
    Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="320">
            <TextBlock Text="Reduces handheld shakes and small rotations with the built-in stabilizer. No downloads or setup are needed. Mirrored edges may be visible; severe movements, rolling shutter and motion blur cannot be repaired. The copy opens in the player when export finishes."
                       TextWrapping="Wrap" />
            <ContentControl x:Name="OptionsPanel" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBox x:Name="OutputBox" Header="New MP4 file"
                             AutomationProperties.AutomationId="StabilizationOutput" />
                    <Button Content="Choose output folder..." Click="OnChooseFolder"
                            AutomationProperties.AutomationId="StabilizationChooseFolder" />
                </StackPanel>
            </ContentControl>
            <TextBlock Text="Exports an H.264/AAC MP4 locally; the original and existing files are never overwritten. Video and audio are re-encoded. Subtitles, extra tracks, HDR fidelity, specialized metadata and sidecars are not preserved."
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Visibility="Collapsed"
                         AutomationProperties.Name="Stabilizing video" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <InfoBar x:Name="ResultBar" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
