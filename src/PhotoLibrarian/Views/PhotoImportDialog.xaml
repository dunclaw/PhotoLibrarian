<ContentDialog
    x:Class="PhotoLibrarian.Views.PhotoImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoLibrarian.Views"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <ContentDialog.Resources>
        <DataTemplate x:Key="PhotoImportItemTemplate" x:DataType="local:PhotoImportListItem">
            <Grid Padding="8,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind FileDetails}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind DateDetails}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind DestinationPreview, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind DestinationPreview, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind ResultText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid MaxWidth="760" MaxHeight="620" RowSpacing="8" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="PhotoImportDescription"
                   Grid.ColumnSpan="3"
                   TextWrapping="Wrap" />

        <TextBlock x:Uid="PhotoImportSourceLabel"
                   Grid.Row="1"
                   VerticalAlignment="Center" />
        <TextBox x:Name="SourceFolderBox"
                 x:Uid="PhotoImportSourceBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 AutomationProperties.AutomationId="PhotoImportSourceFolder"
                 TextChanged="OnSourceFolderChanged" />
        <Button x:Name="BrowseSourceButton"
                x:Uid="PhotoImportSourceBrowseButton"
                Grid.Row="1"
                Grid.Column="2"
                AutomationProperties.AutomationId="PhotoImportBrowseSource"
                Click="OnBrowseSourceClick" />

        <TextBlock x:Uid="PhotoImportDestinationLabel"
                   Grid.Row="2"
                   VerticalAlignment="Center" />
        <TextBox x:Name="DestinationFolderBox"
                 x:Uid="PhotoImportDestinationBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 AutomationProperties.AutomationId="PhotoImportDestinationFolder"
                 TextChanged="OnDestinationChanged" />
        <Button x:Name="BrowseDestinationButton"
                x:Uid="PhotoImportDestinationBrowseButton"
                Grid.Row="2"
                Grid.Column="2"
                AutomationProperties.AutomationId="PhotoImportBrowseDestination"
                Click="OnBrowseDestinationClick" />

        <TextBlock x:Uid="PhotoImportNamingLabel"
                   Grid.Row="3"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
            <TextBox x:Name="NamingTemplateBox"
                     x:Uid="PhotoImportNamingBox"
                     AutomationProperties.AutomationId="PhotoImportNamingTemplate"
                     Text="{x:Bind DefaultNamingTemplate, Mode=OneTime}"
                     TextChanged="OnNamingTemplateChanged" />
            <TextBlock x:Uid="PhotoImportNamingHelp"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Uid="PhotoImportTagsLabel"
                   Grid.Row="4"
                   VerticalAlignment="Center" />
        <TextBox x:Name="ImportTagsBox"
                 x:Uid="PhotoImportTagsBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 AutomationProperties.AutomationId="PhotoImportTags" />

        <CheckBox x:Name="DeleteSourceCheckBox"
                  x:Uid="PhotoImportDeleteSourceCheck"
                  Grid.Row="5"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  AutomationProperties.AutomationId="PhotoImportDeleteSource" />

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button x:Name="ScanButton"
                    x:Uid="PhotoImportScanButton"
                    AutomationProperties.AutomationId="PhotoImportScan"
                    Click="OnScanClick" />
            <Button x:Name="SelectAllButton"
                    x:Uid="PhotoImportSelectAllButton"
                    AutomationProperties.AutomationId="PhotoImportSelectAll"
                    Click="OnSelectAllClick" />
            <Button x:Name="SelectNoneButton"
                    x:Uid="PhotoImportSelectNoneButton"
                    AutomationProperties.AutomationId="PhotoImportSelectNone"
                    Click="OnSelectNoneClick" />
            <TextBlock x:Name="SelectionText"
                       x:Uid="PhotoImportSelectionText"
                       AutomationProperties.AutomationId="PhotoImportSelectionCount"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </StackPanel>

        <InfoBar x:Name="WarningInfoBar"
                 Grid.Row="7"
                 Grid.ColumnSpan="3"
                 IsOpen="False"
                 Severity="Warning"
                 IsClosable="False" />

        <ListView x:Name="PhotoList"
                  x:Uid="PhotoImportList"
                  Grid.Row="8"
                  Grid.ColumnSpan="3"
                  Height="220"
                  SelectionMode="Multiple"
                  ItemTemplate="{StaticResource PhotoImportItemTemplate}"
                  SelectionChanged="OnSelectionChanged" />

        <StackPanel Grid.Row="9"
                    Grid.ColumnSpan="3"
                    Spacing="4">
            <ProgressBar x:Name="ImportProgressBar"
                         x:Uid="PhotoImportProgressBar"
                         AutomationProperties.AutomationId="PhotoImportProgress"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
            <TextBlock x:Name="StatusText"
                       x:Uid="PhotoImportStatusText"
                       AutomationProperties.AutomationId="PhotoImportStatus"
                       TextWrapping="Wrap"
                       MaxHeight="72" />
        </StackPanel>
    </Grid>
</ContentDialog>
