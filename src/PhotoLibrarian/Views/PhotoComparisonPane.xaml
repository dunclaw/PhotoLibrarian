<UserControl
    x:Class="PhotoLibrarian.Views.PhotoComparisonPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameText" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="RemoveButton" x:Uid="ComparisonRemove"
                        AutomationProperties.AutomationId="ComparisonRemove"
                        Grid.Column="1" Click="OnRemove" />
            </Grid>
            <ScrollViewer x:Name="Viewport"
                          AutomationProperties.AutomationId="ComparisonViewport"
                          Grid.Row="1" IsTabStop="True"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          ZoomMode="Disabled" SizeChanged="OnViewportSizeChanged"
                          PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved"
                          PointerReleased="OnPointerReleased" PointerCanceled="OnPointerCanceled"
                          PointerCaptureLost="OnPointerCanceled" PreviewKeyDown="OnKeyDown">
                <Canvas x:Name="ScrollContent">
                    <Grid x:Name="ImageHost">
                        <Image x:Name="Photo" Stretch="Fill" />
                    </Grid>
                </Canvas>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Padding="8" Spacing="4">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <Button x:Name="RetryButton" x:Uid="ComparisonRetry"
                        AutomationProperties.AutomationId="ComparisonRetry"
                        Visibility="Collapsed" Click="OnRetry" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
