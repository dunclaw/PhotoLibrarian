<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PhotoLibrarian</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PhotoLibrarian.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
    <Platforms>x64;ARM64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.ImageCropper" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLibrarian.Core\PhotoLibrarian.Core.csproj" />
    <ProjectReference Include="..\PhotoLibrarian.ML\PhotoLibrarian.ML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\NoiseReduction.cso"
                      LogicalName="PhotoLibrarian.Shaders.NoiseReduction.cso" />
    <EmbeddedResource Include="$(IntermediateOutputPath)Shaders\UnsharpMask.cso"
                      LogicalName="PhotoLibrarian.Shaders.UnsharpMask.cso" />
  </ItemGroup>

  <Target Name="CompileImageProcessingShaders" BeforeTargets="PrepareResources"
          Inputs="Shaders\NoiseReduction.hlsl;Shaders\UnsharpMask.hlsl;$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)Shaders\NoiseReduction.cso;$(IntermediateOutputPath)Shaders\UnsharpMask.cso">
    <PropertyGroup>
      <_ShaderSdkRoot Condition="'$(WindowsSdkDir)' != ''">$(WindowsSdkDir)</_ShaderSdkRoot>
      <_ShaderSdkRoot Condition="'$(_ShaderSdkRoot)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\</_ShaderSdkRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ShaderCompiler Include="$(_ShaderSdkRoot)\bin\*\$(WindowsSDKBuildToolsArchFolder)\fxc.exe" />
    </ItemGroup>
    <PropertyGroup>
      <_ShaderCompilerPaths>@(_ShaderCompiler)</_ShaderCompilerPaths>
      <FxcPath Condition="'$(FxcPath)' == '' AND '$(_ShaderCompilerPaths)' != ''">$(_ShaderCompilerPaths.Split(';')[0])</FxcPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(FxcPath)')" Text="Install the Windows SDK shader compiler (fxc.exe), or set FxcPath to its location." />
    <MakeDir Directories="$(IntermediateOutputPath)Shaders" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T ps_4_0 /E main /O3 /Fo &quot;$(IntermediateOutputPath)Shaders\NoiseReduction.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\NoiseReduction.hlsl&quot;" />
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T ps_4_0 /E main /O3 /Fo &quot;$(IntermediateOutputPath)Shaders\UnsharpMask.cso&quot; &quot;$(MSBuildProjectDirectory)\Shaders\UnsharpMask.hlsl&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Shaders\NoiseReduction.cso" />
      <FileWrites Include="$(IntermediateOutputPath)Shaders\UnsharpMask.cso" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeCompiledXamlInPublish" BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="Prep_ComputeProcessXamlFiles">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(GeneratedXamlDest)">
        <RelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '%(FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
